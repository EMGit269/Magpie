<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetExt>.gha</TargetExt>
    <AssemblyName>Magpie.MacBridge</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <RhinoResources Condition="'$(RhinoResources)' == ''">/Applications/Rhino 8.app/Contents/Frameworks/RhCore.framework/Versions/A/Resources</RhinoResources>
    <GrasshopperResources>$(RhinoResources)/ManagedPlugIns/GrasshopperPlugin.rhp</GrasshopperResources>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RhinoCommon" HintPath="$(RhinoResources)/RhinoCommon.dll" Private="false" />
    <Reference Include="Grasshopper" HintPath="$(GrasshopperResources)/Grasshopper.dll" Private="false" />
    <Reference Include="GH_IO" HintPath="$(GrasshopperResources)/GH_IO.dll" Private="false" />
    <Reference Include="System.Drawing.Common" HintPath="$(RhinoResources)/System.Drawing.Common.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(RhinoResources)/Newtonsoft.Json.dll" Private="false" />
    <Compile Include="*.cs" />
    <Compile Include="../HostBridge/*.cs" Link="HostBridge/%(Filename)%(Extension)" />
    <Compile Include="../Host/GrasshopperDocumentHost.cs" Link="Host/GrasshopperDocumentHost.cs" />
  </ItemGroup>
  <Target Name="CheckRhinoSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RhinoResources)/RhinoCommon.dll')" Text="Rhino 8 for Mac is required. Override RhinoResources for a custom installation." />
  </Target>
</Project>
